# OpenRouter Jev: fill OPENROUTER_API_KEY; never commit .env.
OPENROUTER_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13
# Optional fallback prices per million tokens; prefer usage.cost returned by OpenRouter.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=

# Local models: each server loads one model at a time.
KEV_BASE_URL=http://127.0.0.1:8008
LAYA_BASE_URL=http://127.0.0.1:8009
LOCAL_MODEL_API_KEY=
# If Webots is installed outside its usual macOS location, set its executable.
WEBOTS_EXECUTABLE=/Applications/Webots.app/Contents/MacOS/webots
