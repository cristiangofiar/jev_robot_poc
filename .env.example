# Copy to .env; existing exported environment values take precedence.
# Webots executable: macOS app bundle, Windows webots.exe, or Linux webots.
WEBOTS_EXECUTABLE=
# Alternative installation root used by the launcher.
WEBOTS_HOME=
LAYA_BASE_URL=http://127.0.0.1:8009
KEV_BASE_URL=http://127.0.0.1:8008
LOCAL_MODEL_API_KEY=
# Optional overrides when using your own llama.cpp build / model files.
LLAMA_SERVER=
LOCAL_GPU_LAYERS=99
LAYA_MODEL_PATH=
KEV_MODEL_PATH=
# Jev is optional and may incur API charges; validation uses Laya only.
OPENROUTER_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13
# Interactive Webots defaults; run_experiment.py overrides these explicitly.
MARS_BRAIN=rules
MARS_DURATION_S=900
MARS_DEADLINE_S=2
MARS_MAX_AGE_S=3
